# Full origin of the deployed backend (no trailing slash, no /api). Set once
# frontend and backend are on separate domains — takes priority over the
# hostname-derived fallback below.
VITE_API_BASE_URL=https://advertisers360-backend.vercel.app

# Used only when VITE_API_BASE_URL is unset: the API host is derived at
# runtime from whatever host the page was loaded from (window.location.hostname)
# — so local/LAN dev works the same whether opened via localhost or a LAN IP.
# Only the port is configurable here.
VITE_API_PORT=5000
